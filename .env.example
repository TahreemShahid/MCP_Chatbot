# Embeddings (PDF indexing): https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_key_here

# Chat agent: https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here

# Groq chat model (free tier is generous; 8b has higher daily request limits)
# GROQ_CHAT_MODEL=llama-3.3-70b-versatile
# GROQ_CHAT_MODEL=llama-3.1-8b-instant

# Retries on Groq API errors (default 1). Set 0 to fail fast on 429.
# GROQ_CHAT_MAX_RETRIES=1

# Windows + FAISS: if chat crashes with OpenMP errors, main.py already sets KMP_DUPLICATE_LIB_OK;
# you can also set in the shell: set KMP_DUPLICATE_LIB_OK=TRUE
